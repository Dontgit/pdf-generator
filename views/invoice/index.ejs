<%- include('../partials/header') %>

<!-- 
  Konten utama sekarang ditempatkan langsung di dalam layout dari header.ejs.
  Div pembungkus yang berlebihan telah dihapus untuk memperbaiki tata letak.
-->
<div class="max-w-7xl mx-auto">
  <div class="flex flex-col md:flex-row justify-between items-center mb-6">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-4 md:mb-0">Invoice List</h1>
    <a href="/invoice/new" class="inline-flex items-center bg-blue-600 text-white px-5 py-2 rounded-lg shadow-md hover:bg-blue-700 transition-transform transform hover:scale-105">
      <i class="fa fa-plus mr-2"></i> Add New
    </a>
  </div>

  <div class="overflow-x-auto bg-white rounded-lg shadow-lg">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kegiatan</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sekolah</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Harga</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Harga (Nego)</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if(invoices.length > 0) { %>
          <% invoices.forEach(invoice => { %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= invoice.Kegiatan %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= invoice.Sekolah %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-right"><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(invoice.Total_Harga || 0) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-right"><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(invoice.Total_Harga_sn || 0) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <div class="flex items-center justify-center space-x-4">
                  <button onclick="openFullDataModal('<%= JSON.stringify(invoice).replace(/'/g, '&#39;') %>')" class="text-purple-600 hover:text-purple-900" title="View Full Data">
                    <i class="fa fa-eye"></i>
                  </button>
                  <button onclick="openDetailModal(<%= invoice.id %>)" class="text-green-600 hover:text-green-900" title="View Details">
                    <i class="fa fa-list-alt"></i>
                  </button>
                  <a href="/invoice/<%= invoice.id %>/edit" class="text-blue-600 hover:text-blue-900" title="Edit Invoice">
                    <i class="fa fa-edit"></i>
                  </a>
                  <form action="/invoice/<%= invoice.id %>/delete" method="POST" onsubmit="return confirmDelete(event)">
                    <button type="submit" class="text-red-600 hover:text-red-900" title="Delete Invoice">
                      <i class="fa fa-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center py-10 text-gray-500">
              No invoices found. <a href="/invoice/new" class="text-blue-600 hover:underline">Create one now!</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Detail Invoice Modal -->
<div id="detailModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-6xl p-6 overflow-hidden flex flex-col max-h-[90vh]">
    <div class="flex justify-between items-center mb-4 border-b pb-4">
      <h2 class="text-2xl font-bold text-gray-800">Detail Invoice</h2>
      <button onclick="closeDetailModal()" class="text-gray-500 hover:text-red-600 text-2xl">&times;</button>
    </div>
    <div class="overflow-auto flex-grow">
      <div id="detailContent" class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 mb-4">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-600 uppercase">Barang</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-600 uppercase">Volume</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-600 uppercase">Qty</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-600 uppercase">Satuan</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-600 uppercase">Harga Satuan</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-600 uppercase">Harga Satuan (Nego)</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-600 uppercase">Jumlah</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-600 uppercase">Total (Nego)</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-600 uppercase">Kondisi</th>
              <th class="px-4 py-2 text-center text-xs font-medium text-gray-600 uppercase">Actions</th>
            </tr>
          </thead>
          <tbody id="detailInvoiceBody" class="bg-white divide-y divide-gray-200">
            <!-- Detail invoice rows will be dynamically inserted here -->
          </tbody>
        </table>
      </div>
      <button onclick="showAddDetailForm()" class="bg-blue-600 text-white px-4 py-2 rounded-lg shadow hover:bg-blue-700 mb-4 transition">
        <i class="fa fa-plus mr-2"></i>Add Detail
      </button>
      <form id="addDetailForm" class="p-4 border rounded-lg bg-gray-50 space-y-4 hidden">
        <input type="hidden" id="detailInvoiceId" />
        <input type="hidden" id="detailInvoiceInvoiceId" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label for="Nama_Barang" class="block font-medium text-gray-700">Nama Barang</label>
            <input type="text" id="Nama_Barang" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
          <div>
            <label for="Volume" class="block font-medium text-gray-700">Volume</label>
            <input type="number" id="Volume" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" oninput="syncQty()" />
          </div>
          <div>
            <label for="Qty" class="block font-medium text-gray-700">Qty</label>
            <input type="number" id="Qty" class="w-full border border-gray-300 rounded-md px-3 py-2 bg-gray-100" readonly />
          </div>
          <div>
            <label for="Satuan" class="block font-medium text-gray-700">Satuan</label>
            <input type="text" id="Satuan" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
          <div>
            <label for="Harga_Satuan" class="block font-medium text-gray-700">Harga Satuan</label>
            <input type="number" id="Harga_Satuan" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" oninput="calculateJumlah()" />
          </div>
          <div>
            <label for="Jumlah" class="block font-medium text-gray-700">Jumlah</label>
            <input type="number" id="Jumlah" class="w-full border border-gray-300 rounded-md px-3 py-2 bg-gray-100" readonly />
          </div>
          <div>
            <label for="Harga_Satuan_sn" class="block font-medium text-gray-700">Harga Satuan (Nego)</label>
            <input type="number" id="Harga_Satuan_sn" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" oninput="calculateJumlahNego()" />
          </div>
          <div>
            <label for="Jumlah_sn" class="block font-medium text-gray-700">Jumlah (Nego)</label>
            <input type="number" id="Jumlah_sn" class="w-full border border-gray-300 rounded-md px-3 py-2 bg-gray-100" readonly />
          </div>
          <div>
            <label for="Kondisi" class="block font-medium text-gray-700">Kondisi</label>
            <input type="text" id="Kondisi" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
        </div>
        <div class="flex space-x-2 mt-4">
          <button type="button" onclick="submitDetailForm()" class="bg-green-600 text-white px-4 py-2 rounded-lg shadow hover:bg-green-700 transition">Save</button>
          <button type="button" onclick="hideAddDetailForm()" class="bg-gray-600 text-white px-4 py-2 rounded-lg shadow hover:bg-gray-700 transition">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Full Data Modal -->
<div id="fullDataModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-3xl p-6 overflow-hidden flex flex-col max-h-[90vh]">
    <div class="flex justify-between items-center mb-4 border-b pb-4">
      <h2 class="text-2xl font-bold text-gray-800">Full Invoice Data</h2>
      <button onclick="closeFullDataModal()" class="text-gray-500 hover:text-red-600 text-2xl">&times;</button>
    </div>
    <div id="fullDataContent" class="text-sm text-gray-800 space-y-2 flex-grow overflow-auto">
      <!-- Full invoice data will be populated here by JavaScript -->
    </div>
  </div>
</div>

<script>
   function formatCurrency(value) {
      if (value === null || isNaN(value)) return 'Rp 0';
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(value);
  }

  function confirmDelete(event) {
    event.preventDefault();
    Swal.fire({
      title: 'Are you sure?',
      text: "Data ini tidak dapat dikembalikan!",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33',
      cancelButtonColor: '#3085d6',
      confirmButtonText: 'Ya, hapus!',
      cancelButtonText: 'Batal'
    }).then((result) => {
      if (result.isConfirmed) {
        event.target.submit();
      }
    });
    return false;
  }

  let currentInvoiceId = null;

  function openDetailModal(invoiceId) {
    currentInvoiceId = invoiceId;
    document.getElementById('detailModal').classList.remove('hidden');
    loadDetailInvoice(invoiceId);
  }

  function closeDetailModal() {
    document.getElementById('detailModal').classList.add('hidden');
    clearDetailInvoiceTable();
    hideAddDetailForm();
  }

  async function loadDetailInvoice(invoiceId) {
    try {
      const response = await fetch(`/detail_invoice/api/${invoiceId}`);
      if (!response.ok) throw new Error('Network response was not ok');
      const data = await response.json();
      populateDetailInvoiceTable(data);
    } catch (error) {
      console.error('Error loading detail invoice:', error);
      Swal.fire('Error', 'Gagal memuat detail invoice.', 'error');
    }
  }
   function populateDetailInvoiceTable(details) {
    const tbody = document.getElementById('detailInvoiceBody');
    tbody.innerHTML = ''; // Clear previous data
    if (details.length === 0) {
        tbody.innerHTML = `<tr><td colspan="10" class="text-center py-6 text-gray-500">Belum ada detail untuk invoice ini.</td></tr>`;
        return;
    }
    details.forEach(detail => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="py-2 px-4 border-b">${detail.Nama_Barang || ''}</td>
        <td class="py-2 px-4 border-b">${detail.Volume || ''}</td>
        <td class="py-2 px-4 border-b">${detail.Qty || ''}</td>
        <td class="py-2 px-4 border-b">${detail.Satuan || ''}</td>
        <td class="py-2 px-4 border-b text-right">${formatCurrency(detail.Harga_Satuan)}</td>
        <td class="py-2 px-4 border-b text-right">${formatCurrency(detail.Harga_Satuan_sn)}</td>
        <td class="py-2 px-4 border-b text-right">${formatCurrency(detail.Jumlah)}</td>
        <td class="py-2 px-4 border-b text-right">${formatCurrency(detail.Jumlah_sn)}</td>
        <td class="py-2 px-4 border-b">${detail.Kondisi || ''}</td>
        <td class="py-2 px-4 border-b text-center">
          <button onclick="editDetail(${detail.id})" class="text-blue-600 hover:underline mr-2" title="Edit Detail"><i class="fa fa-edit"></i></button>
          <button onclick="deleteDetail(${detail.id})" class="text-red-600 hover:underline" title="Delete Detail"><i class="fa fa-trash"></i></button>
        </td>
      `;
      tbody.appendChild(tr);
    });
  }


   function clearDetailInvoiceTable() {
    document.getElementById('detailInvoiceBody').innerHTML = '';
  }

  function showAddDetailForm() {
    clearDetailForm();
    document.getElementById('addDetailForm').classList.remove('hidden');
  }

  function hideAddDetailForm() {
    document.getElementById('addDetailForm').classList.add('hidden');
    clearDetailForm();
  }
  

  function clearDetailForm() {
    document.getElementById('detailInvoiceId').value = '';
    document.getElementById('detailInvoiceInvoiceId').value = currentInvoiceId;
    document.getElementById('Nama_Barang').value = '';
    document.getElementById('Volume').value = '';
    document.getElementById('Qty').value = '';
    document.getElementById('Satuan').value = '';
    document.getElementById('Harga_Satuan').value = '';
    document.getElementById('Jumlah').value = '';
    document.getElementById('Harga_Satuan_sn').value = '';
    document.getElementById('Jumlah_sn').value = '';
    document.getElementById('Kondisi').value = '';
  }

  function submitDetailForm() {
    const id = document.getElementById('detailInvoiceId').value;
    const invoiceId = currentInvoiceId;
    const data = {
      Nama_Barang: document.getElementById('Nama_Barang').value,
      Volume: parseFloat(document.getElementById('Volume').value),
      Qty: parseFloat(document.getElementById('Qty').value),
      Satuan: document.getElementById('Satuan').value,
      Harga_Satuan: parseFloat(document.getElementById('Harga_Satuan').value),
      Jumlah: parseFloat(document.getElementById('Jumlah').value),
      Harga_Satuan_sn: parseFloat(document.getElementById('Harga_Satuan_sn').value),
      Jumlah_sn: parseFloat(document.getElementById('Jumlah_sn').value),
      Kondisi: document.getElementById('Kondisi').value,
      Invoice_id: invoiceId
    };
 

    if (id) {
      // Update 
      fetch(`/detail_invoice/api/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
      .then(response => response.json())
      .then(() => {
        loadDetailInvoice(invoiceId);
        hideAddDetailForm();
      })
      .catch(error => {
        console.error('Error updating detail:', error);
      });
    } else {
      // Create new detail
      fetch('/detail_invoice/api', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
      .then(response => response.json())
      .then(() => {
        loadDetailInvoice(invoiceId);
        hideAddDetailForm();
      })
      .catch(error => {
        console.error('Error creating detail:', error);
      });
    }
  }

  function syncQty() {
    const volume = parseFloat(document.getElementById('Volume').value);
    if (!isNaN(volume)) {
      document.getElementById('Qty').value = volume;
    } else {
      document.getElementById('Qty').value = '';
    }
    calculateJumlah(); // Recalculate Jumlah if volume changes
    calculateJumlahNego(); // Recalculate Jumlah if volume changes
  }

  function calculateJumlah() {
    const qty = parseFloat(document.getElementById('Qty').value);
    const hargaSatuan = parseFloat(document.getElementById('Harga_Satuan').value);
    if (!isNaN(qty) && !isNaN(hargaSatuan)) {
      document.getElementById('Jumlah').value = qty * hargaSatuan;
    } else {
      document.getElementById('Jumlah').value = '';
    }
  }
  function calculateJumlahNego() {
    const qty = parseFloat(document.getElementById('Qty').value);
    const hargaSatuan = parseFloat(document.getElementById('Harga_Satuan_sn').value);
    if (!isNaN(qty) && !isNaN(hargaSatuan)) {
      document.getElementById('Jumlah_sn').value = qty * hargaSatuan;
    } else {
      document.getElementById('Jumlah_sn').value = '';
    }
  }


  function editDetail(id) {
    fetch(`/detail_invoice/api/${currentInvoiceId}`)
      .then(response => response.json())
      .then(details => {
        const detail = details.find(d => d.id === id);
        console.log(detail);
        if (detail) {
          showAddDetailForm();
          document.getElementById('detailInvoiceId').value = detail.id;
          document.getElementById('detailInvoiceInvoiceId').value = detail.Invoice_id;
          document.getElementById('Nama_Barang').value = detail.Nama_Barang;
          document.getElementById('Volume').value = detail.Volume;
          document.getElementById('Qty').value = detail.Qty;
          document.getElementById('Satuan').value = detail.Satuan;
          document.getElementById('Harga_Satuan').value = detail.Harga_Satuan;
          document.getElementById('Jumlah').value = detail.Jumlah;
          document.getElementById('Harga_Satuan_sn').value = detail.Harga_Satuan_sn;
          document.getElementById('Jumlah_sn').value = detail.Jumlah_sn;
          document.getElementById('Kondisi').value = detail.Kondisi;
        }
      })
      .catch(error => {
        console.error('Error fetching detail for edit:', error);
      });
  }

  function deleteDetail(id) {
    Swal.fire({
      title: 'Are you sure?',
      text: "This will delete the detail invoice item.",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33',
      cancelButtonColor: '#3085d6',
      confirmButtonText: 'Yes, delete it!'
    }).then((result) => {
      if (result.isConfirmed) {
        fetch(`/detail_invoice/api/${id}`, {
          method: 'DELETE'
        })
        .then(response => response.json())
        .then(() => {
          loadDetailInvoice(currentInvoiceId);
        })
        .catch(error => {
          console.error('Error deleting detail:', error);
        });
      }
    });
  }

   function openFullDataModal(invoiceJson) {
    const invoice = JSON.parse(invoiceJson);
    populateFullDataModal(invoice);
    document.getElementById('fullDataModal').classList.remove('hidden');
  }

  function closeFullDataModal() {
    document.getElementById('fullDataModal').classList.add('hidden');
    document.getElementById('fullDataContent').innerHTML = '';
  }


  function populateFullDataModal(invoice) {
    const container = document.getElementById('fullDataContent');
    container.innerHTML = ''; // Clear previous content

    // Display all key-value pairs from the invoice object
    for (const [key, value] of Object.entries(invoice)) {
      const div = document.createElement('div');
      div.className = 'py-2 px-3 flex justify-between items-center border-b border-gray-100 hover:bg-gray-50 rounded-md';
      
      const strong = document.createElement('strong');
      strong.className = 'text-gray-600 capitalize';
      strong.textContent = key.replace(/_/g, ' '); // Replace underscores with spaces for readability
      
      const span = document.createElement('span');
      // Format numbers as currency, dates if they are dates, otherwise display value
      let displayValue = value;
      if (key.toLowerCase().includes('harga') || key.toLowerCase().includes('total') || key.toLowerCase().includes('ppn')) {
          displayValue = formatCurrency(value);
      }
      span.textContent = displayValue;

      div.appendChild(strong);
      div.appendChild(span);
      container.appendChild(div);
    }
    
    // === PERUBAHAN UTAMA: Tambahkan tombol PDF di sini ===
    
    // Add a separator for visual clarity
    const separator = document.createElement('hr');
    separator.className = 'my-4';
    container.appendChild(separator);

    // Create the link that looks like a button
    const pdfButton = document.createElement('a');
    pdfButton.href = `invoice/invoice-pdf/${invoice.id}`; // The dynamic link to the PDF page
    pdfButton.textContent = 'Buka Halaman PDF';
    pdfButton.target = '_blank'; // Open in a new tab so the user doesn't leave the current page
    pdfButton.rel = 'noopener noreferrer'; // Security best practice for opening new tabs
    
    // Style the link to look like a prominent button
    pdfButton.className = 'w-full inline-block text-center mt-2 bg-teal-600 text-white px-5 py-3 rounded-lg shadow-md hover:bg-teal-700 transition font-semibold';

    // Add an icon to the button
    const icon = document.createElement('i');
    icon.className = 'fa fa-file-pdf mr-2';
    pdfButton.prepend(icon);

    // Append the button to the modal content area
    container.appendChild(pdfButton);
  }

</script>
