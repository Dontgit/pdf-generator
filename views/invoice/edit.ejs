<%- include('../partials/header') %>
<h1 class="text-2xl font-bold mb-4">Edit Invoice</h1>

<form action="/invoice/<%= invoice.id %>" method="POST" class="space-y-4 max-w-lg">
  <div>
    <label for="Kegiatan" class="block font-medium">Kegiatan <span class="text-red-600">*</span></label>
    <input type="text" name="Kegiatan" id="Kegiatan" value="<%= invoice.Kegiatan %>" required class="w-full border rounded px-3 py-2" />
  </div>
  <div>
    <label for="Sekolah" class="block font-medium">Sekolah</label>
    <input type="text" name="Sekolah" id="Sekolah" value="<%= invoice.Sekolah %>" class="w-full border rounded px-3 py-2" />
  </div>
  <div>
    <label for="Total" class="block font-medium">Total</label>
    <input type="number" step="0.01" name="Total" id="Total" value="<%= invoice.Total %>" class="w-full border rounded px-3 py-2" />
  </div>
  <div>
    <label for="PPN" class="block font-medium">PPN</label>
    <input type="number" step="0.01" name="PPN" id="PPN" value="<%= invoice.PPN %>" class="w-full border rounded px-3 py-2" />
  </div>
  <div>
    <label for="Total_Harga" class="block font-medium">Total Harga</label>
    <input type="number" step="0.01" name="Total_Harga" id="Total_Harga" value="<%= invoice.Total_Harga %>" class="w-full border rounded px-3 py-2" />
  </div>
  <div>
    <label for="Costumer_id" class="block font-medium">Costumer</label>
    <select name="Costumer_id" id="Costumer_id" class="w-full border rounded px-3 py-2">
      <option value="">-- Select Costumer --</option>
      <% costumers.forEach(costumer => { %>
        <option value="<%= costumer.id %>" <%= costumer.id === invoice.Costumer_id ? 'selected' : '' %>><%= costumer.Nama %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
      Update
    </button>
    <a href="/invoice" class="ml-4 text-gray-600 hover:underline">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
