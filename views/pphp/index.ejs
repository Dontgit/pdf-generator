<%- include('../partials/header') %>

<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-col sm:flex-row justify-between items-center mb-6">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-4 sm:mb-0">PPHP List</h1>
    <a href="/pphp/new" class="inline-flex items-center bg-blue-600 text-white px-5 py-2 rounded-md shadow hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition">
      <i class="fa fa-plus mr-2" aria-hidden="true"></i>
      Add New PPHP
    </a>
  </div>

  <% if (pphps.length > 0) { %>
    <div class="overflow-x-auto rounded-lg shadow-md border border-gray-200">
      <table class="min-w-full divide-y divide-gray-200 bg-white">
        <thead class="bg-gray-100">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">ID</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Nama</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">NIP</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">NIKKI</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Invoice ID</th>
            <th scope="col" class="relative px-6 py-3">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% pphps.forEach(pphp => { %>
            <tr class="hover:bg-gray-50 transition-colors duration-150 ease-in-out">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800"><%= pphp.id %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800"><%= pphp.Nama %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800"><%= pphp.NIP %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800"><%= pphp.NIKKI %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800"><%= pphp.Invoice_id %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-4">
                <a href="/pphp/<%= pphp.id %>/edit" class="text-blue-600 hover:text-blue-800 transition-colors duration-150" aria-label="Edit <%= pphp.Nama %>" title="Edit <%= pphp.Nama %>">
                  <i class="fa fa-edit fa-fw"></i>
                </a>
                <form action="/pphp/<%= pphp.id %>/delete" method="POST" class="inline" onsubmit="return confirmDelete(event)" aria-label="Delete <%= pphp.Nama %>">
                  <button type="submit" class="text-red-600 hover:text-red-800 focus:outline-none transition-colors duration-150" aria-label="Delete <%= pphp.Nama %>" title="Delete <%= pphp.Nama %>">
                    <i class="fa fa-trash fa-fw"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="text-center py-12 px-6 bg-white rounded-lg shadow-md border border-gray-200">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
      </svg>
      <h3 class="mt-2 text-xl font-semibold text-gray-800">No PPHP Records Found</h3>
      <p class="mt-1 text-sm text-gray-500">
        There are currently no PPHP records to display. Get started by adding a new one.
      </p>
      <div class="mt-6">
        <a href="/pphp/new" class="inline-flex items-center bg-blue-600 text-white px-5 py-2 rounded-md shadow hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition">
          <i class="fa fa-plus mr-2" aria-hidden="true"></i>
          Add New PPHP
        </a>
      </div>
    </div>
  <% } %>
</div>

<script>
  function confirmDelete(event) {
    // event.preventDefault(); // Prevent form submission immediately
    // The onsubmit="return confirmDelete(event)" already handles this by returning true/false
    // or by SweetAlert taking over the submission flow.
    // For SweetAlert, we need to prevent default initially and then submit programmatically.
    event.preventDefault(); 

    Swal.fire({
      title: 'Are you sure?',
      text: "This will delete the PPHP record. This action cannot be undone.",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33', // Red for delete
      cancelButtonColor: '#3085d6', // Blue for cancel
      confirmButtonText: 'Yes, delete it!',
      cancelButtonText: 'Cancel'
    }).then((result) => {
      if (result.isConfirmed) {
        // If confirmed, submit the form that triggered the event
        event.target.submit();
      }
    });
    return false; // Redundant if event.preventDefault() is called, but good practice.
  }
</script>

<%- include('../partials/footer') %>