<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto">
  <!-- Header Halaman dan Tombol Aksi -->
  <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-extrabold text-gray-900">PPHP List</h1>
      <p class="mt-1 text-gray-600">Kelola semua data Panitia Penerima Hasil Pekerjaan (PPHP).</p>
    </div>
    <a href="/pphp/new" class="w-full md:w-auto inline-flex items-center justify-center bg-blue-600 text-white px-5 py-2.5 rounded-lg shadow-md hover:bg-blue-700 transition-transform transform hover:scale-105">
      <i class="fa fa-plus mr-2"></i> Add New PPHP
    </a>
  </div>

  <!-- Bilah Pencarian -->
  <div class="mb-4">
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <i class="fa fa-search text-gray-400"></i>
      </div>
      <input type="text" id="searchInput" onkeyup="searchTable()" placeholder="Cari berdasarkan nama, NIP, atau Invoice ID..." class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-blue-500 focus:border-blue-500 sm:text-sm shadow-sm">
    </div>
  </div>

  <!-- Tabel PPHP -->
  <div class="overflow-x-auto bg-white rounded-lg shadow-lg">
    <table id="pphpTable" class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nama</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">NIP</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">NIKKI</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoice ID</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% if (pphps.length > 0) { %>
          <% pphps.forEach(pphp => { %>
            <tr class="hover:bg-gray-50 transition-colors duration-200">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium"><%= pphp.Nama %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= pphp.NIP %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= pphp.NIKKI %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= pphp.Invoice_id %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <div class="flex items-center justify-center space-x-4">
                  <a href="/pphp/<%= pphp.id %>/edit" class="text-blue-600 hover:text-blue-800 transition" title="Edit <%= pphp.Nama %>">
                    <i class="fa fa-edit fa-fw text-lg"></i>
                  </a>
                  <form action="/pphp/<%= pphp.id %>/delete" method="POST" class="inline" onsubmit="confirmDelete(event, '<%= pphp.Nama %>')">
                    <button type="submit" class="text-red-600 hover:text-red-800 transition" title="Delete <%= pphp.Nama %>">
                      <i class="fa fa-trash fa-fw text-lg"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr id="no-data-row">
            <td colspan="5" class="text-center py-10 px-4">
              <div class="flex flex-col items-center">
                <i class="fa-solid fa-file-circle-question fa-3x text-gray-400 mb-3"></i>
                <p class="text-gray-500 text-lg">Belum ada data PPHP.</p>
                <p class="text-gray-400 text-sm">Tambahkan data PPHP baru untuk memulai.</p>
              </div>
            </td>
          </tr>
        <% } %>
        <tr id="no-results-row" class="hidden">
          <td colspan="5" class="text-center py-10 px-4">
            <div class="flex flex-col items-center">
              <i class="fa fa-search fa-3x text-gray-400 mb-3"></i>
              <p class="text-gray-500 text-lg">Data PPHP tidak ditemukan.</p>
              <p class="text-gray-400 text-sm">Coba kata kunci pencarian yang lain.</p>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  function confirmDelete(event, pphpName) {
    event.preventDefault(); // Mencegah form dari submit secara langsung
    Swal.fire({
      title: 'Apakah Anda yakin?',
      html: `Anda akan menghapus data PPHP: <strong>${pphpName}</strong>. <br/>Aksi ini tidak dapat dibatalkan.`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33',
      cancelButtonColor: '#3085d6',
      confirmButtonText: 'Ya, hapus!',
      cancelButtonText: 'Batal'
    }).then((result) => {
      if (result.isConfirmed) {
        // Jika dikonfirmasi, submit formnya
        event.target.submit();
      }
    });
  }

  function searchTable() {
    const input = document.getElementById('searchInput');
    const filter = input.value.toUpperCase();
    const table = document.getElementById('pphpTable');
    const tr = table.getElementsByTagName('tr');
    const noResultsRow = document.getElementById('no-results-row');
    const noDataRow = document.getElementById('no-data-row');
    let dataRowsFound = 0;

    for (let i = 1; i < tr.length; i++) { // Mulai dari 1 untuk melewati header
      if (tr[i].id.includes('row')) continue; // Lewati baris no-data/no-results

      let rowVisible = false;
      const td = tr[i].getElementsByTagName('td');
      for (let j = 0; j < td.length - 1; j++) { // Loop kolom data, lewati kolom action
        if (td[j] && td[j].textContent.toUpperCase().indexOf(filter) > -1) {
          rowVisible = true;
          break;
        }
      }
      tr[i].style.display = rowVisible ? '' : 'none';
      if (rowVisible) dataRowsFound++;
    }
    
    // Tampilkan pesan "tidak ditemukan" jika tidak ada baris yang cocok
    if (noResultsRow) {
        noResultsRow.style.display = (dataRowsFound === 0 && <% pphps.length > 0 %>) ? '' : 'none';
    }
    // Sembunyikan pesan "no data" jika sedang mencari
    if (noDataRow) {
        noDataRow.style.display = (<% pphps.length === 0 %> && filter === '') ? '' : 'none';
    }
  }
</script>

<%- include('../partials/footer') %>
