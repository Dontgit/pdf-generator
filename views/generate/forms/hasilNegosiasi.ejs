<%- include('../../partials/header') %>

<div class="max-w-3xl mx-auto p-6 bg-white rounded-lg shadow-md mt-10">
  <h2 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-2">Generate Dokumen Hasil Negosiasi</h2>

  <form action="/generate/pdf/dokumen-negosiasi" method="POST" class="space-y-6">
    <input type="hidden" name="invoiceId" value="<%= invoiceId %>">

    <div>
      <label for="daerah" class="block font-medium text-gray-700 mb-1">Tempat Pembuatan Surat</label>
      <input type="text" id="daerah" name="daerah" required
        placeholder="Contoh: Padang"
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring focus:border-blue-500" />
    </div>

    <div>
      <label for="tanggalterima" class="block font-medium text-gray-700 mb-1">Tanggal Terima Barang/Jasa</label>
      <input type="date" id="tanggalterima" name="tanggalterima" required
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring focus:border-blue-500" />
    </div>

    <!-- Styled Checkbox -->
    <div class="flex items-center space-x-3">
      <input type="checkbox" name="download" id="download"
        class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
      <label for="download" class="text-gray-700 text-sm select-none">
        Tandai sebagai final (tidak akan ada update lagi)
      </label>
    </div>


    <div class="flex justify-between pt-4">
      <a href="/generate" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">Kembali</a>
      <button type="submit"
        class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all">Generate PDF</button>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
