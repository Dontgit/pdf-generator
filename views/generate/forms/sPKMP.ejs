<%- include('../../partials/header') %>

<div class="max-w-2xl mx-auto bg-white shadow-md rounded-lg p-6 mt-10">
  <h2 class="text-2xl font-bold text-center text-blue-700 mb-6">Generate Surat Kesanggupan Melaksanakan Kegiatan</h2>

  <form action="/generate/pdf/surat-kesanggupan" method="POST" class="space-y-5">
    <input type="hidden" name="invoiceId" value="<%= invoiceId %>">

    <div>
      <label for="nomor" class="block font-medium text-gray-700 mb-1">Nomor Surat</label>
      <input
        type="text"
        id="nomor"
        name="nomor"
        required
        placeholder="Contoh: 015/UNDN/2025"
        class="w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>
    <!-- Styled Checkbox -->
    <div class="flex items-center space-x-3">
      <input type="checkbox" name="download" id="download"
        class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
      <label for="download" class="text-gray-700 text-sm select-none">
        Tandai sebagai final (tidak akan ada update lagi)
      </label>
    </div>



    <div class="flex justify-between items-center">
      <button
        type="submit"
        class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition"
      >
        <i class="fa fa-file-pdf-o mr-2"></i> Generate PDF
      </button>
      <a
        href="/generate"
        class="bg-gray-100 text-gray-700 px-6 py-2 rounded hover:bg-gray-200 transition"
      >
        <i class="fa fa-arrow-left mr-2"></i> Kembali
      </a>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
