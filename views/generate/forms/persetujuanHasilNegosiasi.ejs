<%- include('../../partials/header') %>

<div class="container mx-auto max-w-2xl bg-white p-6 rounded shadow">
  <h2 class="text-2xl font-bold mb-6">Form Persetujuan Hasil Negosiasi</h2>

  <form action="/generate/pdf/persetujuan-negosiasi" method="POST" class="space-y-5">
    <input type="hidden" name="invoiceId" value="<%= invoiceId %>">

    <div>
      <label for="nomor" class="block font-medium mb-1">Nomor Surat</label>
      <input type="text" id="nomor" name="nomor" required class="w-full border px-4 py-2 rounded" placeholder="Contoh: 123/SPH/VI/2025">
    </div>
    <div>
      <label for="daerah" class="block font-medium text-gray-700 mb-1">Daerah Surat Dibuat</label>
      <input
        type="text"
        id="daerah"
        name="daerah"
        placeholder="Contoh: Jakarta"
        required
        class="w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div class="flex justify-between items-center pt-4">
      <button type="submit" class="bg-blue-600 text-white font-semibold px-6 py-2 rounded hover:bg-blue-700">
        Generate PDF
      </button>
      <a href="/generate" class="text-blue-600 hover:underline">← Kembali</a>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
