<%- include('../../partials/header') %>

<h1 class="text-2xl font-bold mb-6">Form Generate Surat BOP</h1>

<form action="/generate/pdf/bop" method="POST" class="max-w-lg space-y-6">
  <input type="hidden" name="invoiceId" value="<%= invoiceId %>">

  <div>
    <label for="nomor" class="block mb-1 font-semibold text-gray-700">Nomor</label>
    <input
      type="text"
      id="nomor"
      name="nomor"
      class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
      placeholder="Contoh: 421.5/SMK-24/BOP/V/2025"
      required
    />
  </div>
  

  <div>
    <label for="sifat" class="block mb-1 font-semibold text-gray-700">Sifat</label>
    <input
      type="text"
      id="sifat"
      name="sifat"
      class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
      placeholder="Sifat Surat (e.g. Penting, Biasa)"
      required
    />
  </div>

  <div>
    <label for="lampiran" class="block mb-1 font-semibold text-gray-700">Lampiran</label>
    <input
      type="text"
      id="lampiran"
      name="lampiran"
      class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
      placeholder="Jumlah lampiran (opsional)"
    />
  </div>
  <!-- Styled Checkbox -->
    <div class="flex items-center space-x-3">
      <input type="checkbox" name="download" id="download"
        class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
      <label for="download" class="text-gray-700 text-sm select-none">
        Tandai sebagai final (tidak akan ada update lagi)
      </label>
    </div>


  <button
    type="submit"
    class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700 transition"
  >
    Generate PDF
  </button>
</form>

<%- include('../../partials/footer') %>
