<!-- views/generate/form-serah-terima.ejs -->
<%- include('../../partials/header') %>

<div class="max-w-3xl mx-auto p-6 bg-white shadow-lg mt-10 rounded-md">
  <h2 class="text-2xl font-bold mb-6 text-center">Generate Berita Acara Serah Terima</h2>

  <form action="/generate/pdf/berita-acara-serah-terima" method="POST" class="space-y-5">
    <input type="hidden" name="invoiceId" value="<%= invoiceId %>">
    <!-- Input Nomor Surat -->
    <div>
      <label for="nomor" class="block font-medium text-gray-700">Nomor Surat</label>
      <input type="text" id="nomor" name="nomor" required
        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" />
    </div>

    <!-- Input Tanggal Surat -->
    <div>
      <label for="tanggalsurat" class="block font-medium text-gray-700">Tanggal Surat</label>
      <input type="date" id="tanggalsurat" name="tanggalsurat" required
        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" />
    </div>

    <!-- Input Nama Pihak Pertama -->
    <div>
      <label for="nama" class="block font-medium text-gray-700">Nama Pihak Pertama</label>
      <input type="text" id="nama" name="nama" required
        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" />
    </div>

    <!-- Input Jabatan Pihak Pertama -->
    <div>
      <label for="jabatan" class="block font-medium text-gray-700">Jabatan Pihak Pertama</label>
      <input type="text" id="jabatan" name="jabatan" required
        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" />
    </div>

    

    <!-- Tombol -->
    <div class="flex justify-between items-center mt-6">
      <a href="/generate" class="text-gray-600 hover:text-blue-600 underline">← Kembali</a>
      <button type="submit"
        class="bg-blue-600 text-white px-5 py-2 rounded-md hover:bg-blue-700 transition font-semibold">
        Generate PDF
      </button>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
