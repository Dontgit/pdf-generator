<%- include('../../partials/header') %>

<div class="max-w-2xl mx-auto bg-white p-6 rounded shadow mt-8">
  <h2 class="text-xl font-semibold mb-4 text-center">Generate HPS</h2>

  <form action="/generate/pdf/hps" method="POST" class="space-y-4">
    <input type="hidden" name="invoiceId" value="<%= invoiceId %>">
    <!-- Buttons -->
    <div class="flex items-center justify-between mt-6">
      <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">Generate PDF</button>
      <a href="/generate" class="text-blue-600 hover:underline">Kembali</a>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
