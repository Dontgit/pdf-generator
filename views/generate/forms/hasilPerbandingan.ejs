<%- include('../../partials/header') %>

<div class="max-w-3xl mx-auto p-6 bg-white rounded-lg shadow-md mt-10">
  <h2 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-2">Generate Dokumen Hasil Pembandingan</h2>

  <form action="/generate/pdf/dokumen-pembandingan" method="POST" class="space-y-5">
    <input type="hidden" name="invoiceId" value="<%= invoiceId %>">

    <div>
      <label for="calonpenyedia" class="block font-medium text-gray-700 mb-1">Nama Calon Penyedia Produk 2</label>
      <input type="text" id="calonpenyedia" name="calonpenyedia" required
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring focus:border-blue-500"
        placeholder="Contoh: PT. Kharisma Andal Raya" />
    </div>

    <div>
      <label for="harga" class="block font-medium text-gray-700 mb-1">Harga Satuan Produk 2</label>
      <input type="text" id="harga" name="harga" required
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring focus:border-blue-500"
        placeholder="Contoh: Rp 646.016" />
    </div>

    <div>
      <label for="estimasipengirimanproduk2" class="block font-medium text-gray-700 mb-1">Estimasi Pengiriman Produk 2</label>
      <input type="date" id="estimasipengirimanproduk2" name="estimasipengirimanproduk2" required
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring focus:border-blue-500" />
    </div>

    <div>
      <label for="alamatcalon" class="block font-medium text-gray-700 mb-1">Alamat Calon Penyedia Produk 2</label>
      <textarea id="alamatcalon" name="alamatcalon" rows="3" required
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring focus:border-blue-500"
        placeholder="Contoh: MTH Square GF A4, Jl. Lentjen M.T Haryono, Jakarta Timur, 13330"></textarea>
    </div>

    <!-- Styled Checkbox -->
    <div class="flex items-center space-x-3">
      <input type="checkbox" name="download" id="download"
        class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
      <label for="download" class="text-gray-700 text-sm select-none">
        Tandai sebagai final (tidak akan ada update lagi)
      </label>
    </div>


    <div class="flex justify-between pt-6">
      <a href="/generate" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">Kembali</a>
      <button type="submit"
        class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all">Generate PDF</button>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
