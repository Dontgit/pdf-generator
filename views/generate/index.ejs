<%- include('../partials/header') %>

<h1 class="text-3xl font-extrabold mb-8 text-gray-900">Generate Dokumen</h1>

<div class="mb-8 max-w-md">
  <label for="invoiceSelect" class="block mb-3 font-semibold text-gray-700">Pilih Invoice:</label>
  <select id="invoiceSelect" required class="w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
    <option value="">-- Pilih Invoice --</option>
    <% invoices.forEach(inv => { %>
      <option value="<%= inv.id %>"><%= inv.Kegiatan %></option>
    <% }) %>
  </select>
</div>

<h2 class="text-2xl font-semibold mb-6 text-gray-800">Pilih Jenis Generate:</h2>
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 max-w-5xl">
  <% generateMenus.forEach(menu => { %>
    <button
      class="generate-btn bg-blue-600 text-white font-semibold py-3 px-6 rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition flex items-center justify-center gap-2"
      data-key="<%= menu.key %>"
      type="button"
      aria-label="Generate <%= menu.label %>"
    >
      <i class="fa fa-file-alt"></i>
      <%= menu.label %>
    </button>
  <% }) %>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.6.5/flowbite.min.js"></script>
<script>
  document.querySelectorAll('.generate-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const invoiceId = document.getElementById('invoiceSelect').value;
      if (!invoiceId) {
        alert('Silakan pilih invoice terlebih dahulu!');
        return;
      }
      const key = btn.getAttribute('data-key');
      window.location.href = `/generate/${key}?invoiceId=${invoiceId}`;
    });
  });
</script>

<%- include('../partials/footer') %>
