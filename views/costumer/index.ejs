<%- include('../partials/header') %>
<div class="flex flex-col md:flex-row justify-between items-center mb-6">
  <h1 class="text-3xl font-extrabold text-gray-900 mb-4 md:mb-0">Customer List</h1>
  <a href="/costumer/new" class="inline-flex items-center bg-blue-600 text-white px-5 py-2 rounded-lg shadow hover:bg-blue-700 transition">
    <i class="fa fa-plus mr-2"></i> Add New
  </a>
</div>

<div class="overflow-x-auto bg-white rounded-lg shadow">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kop Surat</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jabatan</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nama</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">NIP</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sekolah</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Alamat</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% costumers.forEach(costumer => { %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= costumer.id %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= costumer.kop_surat %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= costumer.Jabatan %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= costumer.Nama %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= costumer.NIP %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= costumer.Sekolah %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= costumer.Alamat %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex space-x-4">
            <a href="/costumer/<%= costumer.id %>/edit" class="text-blue-600 hover:text-blue-900" title="Edit">
              <i class="fa fa-edit"></i>
            </a>
            <form action="/costumer/<%= costumer.id %>/delete" method="POST" onsubmit="return confirmDelete(event)">
              <button type="submit" class="text-red-600 hover:text-red-900" title="Delete">
                <i class="fa fa-trash"></i>
              </button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<script>
  function confirmDelete(event) {
    event.preventDefault();
    Swal.fire({
      title: 'Are you sure?',
      text: "This will delete the customer record.",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33',
      cancelButtonColor: '#3085d6',
      confirmButtonText: 'Yes, delete it!'
    }).then((result) => {
      if (result.isConfirmed) {
        event.target.submit();
      }
    });
    return false;
  }
</script>
<%- include('../partials/footer') %>
