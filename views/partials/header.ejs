<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof title !== 'undefined' ? title : 'CRUD PDF' %></title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Flowbite -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.6.5/flowbite.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.6.5/flowbite.min.js"></script>
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        /* Menambahkan transisi yang mulus untuk sidebar */
        .sidebar-transition {
            transition: transform 0.3s ease-in-out;
        }
    </style>
</head>
<body class="bg-gray-50">

<div class="flex">
    <!-- Sidebar -->
    <aside id="sidebar" class="fixed top-0 left-0 z-40 w-64 h-screen bg-white border-r border-gray-200 flex flex-col sidebar-transition transform -translate-x-full md:translate-x-0">
        <!-- Logo/Header Sidebar -->
        <div class="flex items-center justify-between h-20 px-6 border-b border-gray-200 flex-shrink-0">
            <a href="/" class="flex items-center gap-3">
                <i class="fa-solid fa-layer-group text-blue-600 text-2xl"></i>
                <span class="text-xl font-bold text-gray-800 self-center whitespace-nowrap">AppManager</span>
            </a>
            <!-- Tombol Close untuk Mobile -->
            <button id="closeSidebarBtn" class="md:hidden text-gray-500 hover:text-gray-800">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <!-- Daftar Navigasi -->
        <nav class="flex-grow px-4 py-6 overflow-y-auto">
            <ul class="space-y-2">
                <% 
                    const navItems = [
                        { href: '/costumer', icon: 'fa-users', label: 'Costumer', key: 'costumer' },
                        { href: '/invoice', icon: 'fa-file-invoice', label: 'Invoice', key: 'invoice' },
                        { href: '/pphp', icon: 'fa-file-alt', label: 'PPHP', key: 'pphp' },
                        { href: '/generate', icon: 'fa-cogs', label: 'Generate', key: 'generate' }
                    ];
                    // FIX: Menggunakan nama variabel baru ('activePage') untuk menghindari ReferenceError.
                    // Variabel 'currentPage' diharapkan dikirim dari route Express.
                    const activePage = typeof currentPage !== 'undefined' ? currentPage : '';
                %>

                <% navItems.forEach(item => { %>
                    <% const isActive = item.key === activePage; %>
                    <li>
                        <a href="<%= item.href %>" 
                           class="flex items-center p-3 text-base font-medium rounded-lg transition-all duration-200 <%= isActive ? 'bg-blue-50 text-blue-600 shadow-sm' : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900' %>">
                            <i class="fa <%= item.icon %> w-6 text-center text-lg <%= isActive ? 'text-blue-600' : 'text-gray-400' %>"></i>
                            <span class="ml-3"><%= item.label %></span>
                        </a>
                    </li>
                <% }) %>
            </ul>
        </nav>
        
        <!-- Footer Sidebar -->
        <div class="p-4 border-t border-gray-200 flex-shrink-0">
            <a href="#" class="flex items-center w-full p-2 text-base text-gray-600 rounded-lg hover:bg-gray-100">
                <img class="w-8 h-8 rounded-full" src="https://placehold.co/40x40/E2E8F0/4A5568?text=A" alt="User" />
                <div class="ml-3">
                    <p class="text-sm font-semibold">Admin User</p>
                    <p class="text-xs text-gray-500">admin@example.com</p>
                </div>
            </a>
        </div>
    </aside>

    <!-- Overlay untuk mobile, awalnya tersembunyi -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black bg-opacity-50 z-30 hidden md:hidden"></div>

    <!-- Konten Utama -->
    <div class="flex-1 flex flex-col">
        <!-- Header Utama (Hanya untuk Mobile) -->
        <header class="md:hidden sticky top-0 bg-white shadow-sm z-20">
            <div class="flex items-center justify-between h-16 px-4">
                <button id="openSidebarBtn" class="text-gray-600 hover:text-gray-900">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                 <a href="/" class="flex items-center gap-2">
                    <i class="fa-solid fa-layer-group text-blue-600 text-xl"></i>
                    <span class="text-lg font-bold text-gray-800">AppManager</span>
                </a>
                <div class="w-8"></div> <!-- Spacer -->
            </div>
        </header>

        <main class="flex-1 p-4 md:pl-72 md:pt-8">
            <!-- Div ini adalah tempat konten dari halaman Anda akan masuk -->
